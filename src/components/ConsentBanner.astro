---
/* Analytics consent banner. Shown only to visitors in regions that require
 * opt-in consent; consent.js decides and binds the buttons. */
---

<div
  id="consent-banner"
  hidden
  aria-hidden="true"
  role="dialog"
  aria-labelledby="consent-title"
  aria-describedby="consent-desc"
  class="consent"
>
  <div class="consent-card">
    <p id="consent-title" class="consent-title">Cookie preferences</p>
    <p id="consent-desc" class="consent-desc">
      We use Google Analytics to understand aggregate site usage. Accept to
      enable analytics cookies, or reject to continue without them.
      <a href="https://jamestannahill.com/privacy">Privacy Policy</a>
    </p>
    <div class="consent-actions">
      <button id="consent-accept" type="button" class="consent-btn consent-btn-accept">
        Accept
      </button>
      <button id="consent-reject" type="button" class="consent-btn consent-btn-reject">
        Reject
      </button>
    </div>
  </div>
</div>

<style>
  .consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    padding: 0 1rem 1rem;
  }

  .consent-card {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .consent-title {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .consent-desc {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .consent-desc a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Same button language as the rest of the site: serif, primary in the
     warm gold treatment, secondary as a neutral chip. */
  .consent-btn {
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s, transform 160ms ease-out;
  }
  .consent-btn:active { transform: scale(0.97); }

  .consent-btn-accept {
    background: linear-gradient(135deg, #2a2218, #1a1814);
    border: 1px solid #c9a66b55;
    color: var(--color-accent);
    font-weight: 600;
  }
  .consent-btn-accept:hover {
    background: linear-gradient(135deg, #3a3228, #2a2420);
    border-color: #c9a66b88;
  }

  .consent-btn-reject {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-body);
  }
  .consent-btn-reject:hover { border-color: #444; color: var(--color-fg); }
</style>
