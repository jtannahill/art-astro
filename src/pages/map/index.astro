---
/**
 * Mapbox dark globe with weather artwork + palette markers.
 * Marker data baked into the page at build time; Mapbox renders client-side.
 *
 * The pk.* token below is a public client token - same one production uses
 * (it's exposed in every page's HTML there too).
 */
import { getCollection } from "astro:content";
import { PUBLIC_MAPBOX_TOKEN } from "astro:env/client";
import Base from "../../layouts/Base.astro";
import { ARTISTS_BY_KEY } from "../../data/artists.ts";

const PROD = "https://art.jamestannahill.com";
const MAPBOX_TOKEN = PUBLIC_MAPBOX_TOKEN;

const allWeather = await getCollection("weather");
const allPalettes = await getCollection("palettes");

interface MarkerW {
  lat: number;
  lng: number;
  title: string;
  artist: string;
  url: string;
  img: string;
}
interface MarkerP {
  lat: number;
  lng: number;
  title: string;
  url: string;
  img: string;
}

const weatherMarkers: MarkerW[] = allWeather
  .filter((w) => w.data.lat != null && w.data.lng != null && w.data.run_id && w.data.slug)
  .map((w) => ({
    lat: w.data.lat!,
    lng: w.data.lng!,
    title: w.data.slug.replace(/-/g, " "),
    artist: ARTISTS_BY_KEY[w.data.artist]?.display ?? w.data.artist.replace(/_/g, " "),
    url: `/weather/${w.data.run_id}/${w.data.slug}/`,
    // 480px WebP (~10-45 KB) — popups are ~260px wide; the 2048 PNG
    // here used to cost ~1.7 MB per marker click.
    img: `${PROD}/weather/${w.data.run_id}/${w.data.slug}/preview-480.webp`,
  }));

// One palette pin per location (latest sample)
const latestPerLocation = new Map<string, (typeof allPalettes)[number]>();
for (const p of allPalettes) {
  const cur = latestPerLocation.get(p.data.location_slug);
  if (!cur || (p.data.date ?? "").localeCompare(cur.data.date ?? "") > 0) {
    latestPerLocation.set(p.data.location_slug, p);
  }
}
const paletteMarkers: MarkerP[] = [...latestPerLocation.values()]
  .filter((p) => p.data.lat != null && p.data.lng != null)
  .map((p) => ({
    lat: p.data.lat!,
    lng: p.data.lng!,
    title: p.data.location_slug.replace(/-/g, " "),
    url: `/palettes/${p.data.location_slug}/`,
    img: `${PROD}/palettes/${p.data.date}/${p.data.location_slug}/source-thumb.jpg`,
  }));
---

<Base
  title="World Map | art.jt"
  description="Every artwork and palette plotted on a dark globe."
>
  <h1>World Map</h1>
  <p class="lede muted">
    Every artwork and palette location, plotted on a Mapbox dark globe.
    {weatherMarkers.length} weather pins · {paletteMarkers.length} palette pins.
  </p>

  <div id="map" class="map" role="region" aria-label="World map of artwork and palette locations"></div>
  <p class="map-fail muted" data-map-fail hidden>
    The map could not load. Every piece is still listed in the <a href="/archive/">archive</a>.
  </p>

  <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/v3.7.0/mapbox-gl.css" />
  <script
    src="https://api.mapbox.com/mapbox-gl-js/v3.7.0/mapbox-gl.js"
    is:inline
  ></script>

  <script
    is:inline
    define:vars={{ MAPBOX_TOKEN, weatherMarkers, paletteMarkers }}
  >
    let waited = 0;
    function init() {
      if (typeof mapboxgl === "undefined") {
        // Give the CDN script ~10s, then say so instead of an empty frame.
        if ((waited += 60) > 10000) {
          const fail = document.querySelector("[data-map-fail]");
          if (fail) fail.hidden = false;
          return;
        }
        setTimeout(init, 60);
        return;
      }
      mapboxgl.accessToken = MAPBOX_TOKEN;
      const map = new mapboxgl.Map({
        container: "map",
        style: "mapbox://styles/mapbox/dark-v11",
        projection: "globe",
        zoom: 1.4,
        center: [-30, 30],
      });
      map.on("style.load", () => {
        map.setFog({
          color: "rgb(20, 20, 30)",
          "high-color": "rgb(40, 30, 60)",
          "horizon-blend": 0.05,
          "space-color": "rgb(8, 8, 14)",
          "star-intensity": 0.6,
        });
      });

      // Styled by the .map-pop rules below, in the site serif.
      function popupHtml(p) {
        const isPalette = p.kind === "p";
        return (
          '<div class="map-pop">' +
          '<img src="' + p.img + '" alt="" loading="lazy" width="200" height="200">' +
          '<div class="map-pop-body">' +
          '<div class="map-pop-title">' + p.title + '</div>' +
          (isPalette
            ? '<div class="map-pop-sub">satellite palette</div>'
            : '<div class="map-pop-sub is-art">' + (p.artist || "") + '</div>') +
          '<a class="map-pop-link" href="' + p.url + '">view →</a>' +
          '</div></div>'
        );
      }

      function toFeatures(arr, kind) {
        return arr.map((m) => ({
          type: "Feature",
          geometry: { type: "Point", coordinates: [m.lng, m.lat] },
          properties: { kind, ...m },
        }));
      }

      map.on("load", () => {
        const features = [
          ...toFeatures(weatherMarkers, "w"),
          ...toFeatures(paletteMarkers, "p"),
        ];
        map.addSource("pieces", {
          type: "geojson",
          data: { type: "FeatureCollection", features },
          cluster: true,
          clusterMaxZoom: 6,
          clusterRadius: 40,
        });

        map.addLayer({
          id: "clusters",
          type: "circle",
          source: "pieces",
          filter: ["has", "point_count"],
          paint: {
            "circle-color": [
              "step", ["get", "point_count"],
              "#5a4a32", 10,
              "#7a6242", 50,
              "#c9a66b",
            ],
            "circle-radius": [
              "step", ["get", "point_count"],
              14, 10, 20, 50, 28,
            ],
            "circle-stroke-color": "rgba(255,255,255,0.15)",
            "circle-stroke-width": 1,
            "circle-opacity": 0.85,
          },
        });
        map.addLayer({
          id: "cluster-count",
          type: "symbol",
          source: "pieces",
          filter: ["has", "point_count"],
          layout: {
            "text-field": ["get", "point_count_abbreviated"],
            "text-font": ["DIN Offc Pro Medium", "Arial Unicode MS Bold"],
            "text-size": 12,
          },
          paint: { "text-color": "#fff" },
        });
        map.addLayer({
          id: "pins",
          type: "circle",
          source: "pieces",
          filter: ["!", ["has", "point_count"]],
          paint: {
            "circle-color": [
              "match", ["get", "kind"],
              "p", "#4ade80",
              "#c9a66b",
            ],
            "circle-radius": 6,
            "circle-stroke-color": "rgba(255,255,255,0.25)",
            "circle-stroke-width": 1,
          },
        });

        map.on("click", "clusters", (e) => {
          const f = map.queryRenderedFeatures(e.point, { layers: ["clusters"] })[0];
          const clusterId = f.properties.cluster_id;
          map.getSource("pieces").getClusterExpansionZoom(clusterId, (err, zoom) => {
            if (err) return;
            map.easeTo({ center: f.geometry.coordinates, zoom });
          });
        });
        map.on("click", "pins", (e) => {
          const f = e.features[0];
          new mapboxgl.Popup({ closeButton: false, maxWidth: "220px" })
            .setLngLat(f.geometry.coordinates)
            .setHTML(popupHtml(f.properties))
            .addTo(map);
        });
        for (const layer of ["clusters", "pins"]) {
          map.on("mouseenter", layer, () => (map.getCanvas().style.cursor = "pointer"));
          map.on("mouseleave", layer, () => (map.getCanvas().style.cursor = ""));
        }
      });
    }
    init();
  </script>
</Base>

<style>
  h1 { font-size: 2rem; margin: 0 0 0.5rem; letter-spacing: -0.02em; }
  .lede { max-width: 60ch; margin: 0 0 1.5rem; }
  .map {
    height: 70vh;
    min-height: 500px;
    border-radius: 8px;
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    background: #0a0a0a;
    touch-action: none;
  }
  .map-fail { margin: 1rem 0 0; }

  /* Popup markup is injected by Mapbox outside Astro's scope. */
  .map :global(.mapboxgl-popup-content) {
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: none;
    overflow: hidden;
  }
  .map :global(.mapboxgl-popup-tip) { display: none; }
  .map :global(.map-pop) { width: 200px; font-family: var(--font-sans); color: var(--color-text-body); }
  .map :global(.map-pop img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background: #0a0a0a;
  }
  .map :global(.map-pop-body) { padding: 0.5rem 0.75rem 0.6rem; }
  .map :global(.map-pop-title) { font-size: 0.95rem; color: var(--color-fg); text-transform: capitalize; line-height: 1.3; }
  .map :global(.map-pop-sub) { font-size: 0.8rem; color: var(--color-muted); text-transform: capitalize; }
  .map :global(.map-pop-sub.is-art) { color: var(--color-accent); text-transform: none; }
  .map :global(.map-pop-link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.85rem;
    color: var(--color-link);
  }

  @media (max-width: 720px) {
    .map {
      height: calc(100svh - 14rem);
      min-height: 320px;
    }
  }
</style>
