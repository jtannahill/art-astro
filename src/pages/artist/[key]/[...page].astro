---
/**
 * Per-artist gallery, paginated like /archive/. Page 1 stays at
 * /artist/{key}/ and carries the methodology block; later pages are
 * noindex and kept out of the sitemap (sitemap-policy.mjs).
 */
import type { GetStaticPaths, Page } from "astro";
import Base from "../../../layouts/Base.astro";
import Methodology from "../../../components/Methodology.astro";
import Thumb from "../../../components/Thumb.astro";
import { ARTISTS, ARTISTS_BY_KEY, LORA_METHODOLOGY } from "../../../data/artists.ts";
import { piecesFor } from "../../../lib/pieces.ts";
import { artistSeoTitle, formatCoords, pieceH1 } from "../../../lib/seo.ts";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const pages = await Promise.all(
    ARTISTS.map(async (a) => paginate(await piecesFor(a.key), { pageSize: 60, params: { key: a.key } }))
  );
  return pages.flat();
};

type Piece = Awaited<ReturnType<typeof piecesFor>>[number];
const { page } = Astro.props as { page: Page<Piece> };
const { key } = Astro.params;
if (!key || !(key in ARTISTS_BY_KEY)) {
  return Astro.rewrite("/404/");
}
const artist = ARTISTS_BY_KEY[key];
const methodology = page.currentPage === 1 ? LORA_METHODOLOGY[key] : undefined;
const pieces = page.data;
const total = page.total;

const PROD = "https://art.jamestannahill.com";
---

<Base
  title={page.currentPage === 1 ? artistSeoTitle(artist.display, total) : `${artist.display} Weather Art, page ${page.currentPage} | art.jt`}
  description={`Generative weather art through the lens of ${artist.display}. ${total} pieces in the archive.`}
  canonicalPath={page.currentPage === 1 ? `/artist/${key}/` : undefined}
  robots={page.currentPage > 1 ? "noindex, follow" : undefined}
>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>

  <header class="artist-head">
    <h1>{artist.display}</h1>
    <p class="muted">
      <a href={artist.link} target="_blank" rel="noopener">about this artist ↗</a>
      {methodology && (
        <span class="lora-tag">· custom FLUX.1-dev LoRA</span>
      )}
    </p>
  </header>

  {methodology && (
    <section class="methodology">
      <Methodology m={methodology} />
    </section>
  )}

  <section class="gallery">
    <header class="gallery-head">
      <h2>Gallery</h2>
      <span class="muted">
        {total} {total === 1 ? "piece" : "pieces"}{page.lastPage > 1 && `, page ${page.currentPage} of ${page.lastPage}`}
      </span>
    </header>

    {pieces.length === 0 ? (
      <p class="empty">No pieces in the archive yet for this artist.</p>
    ) : (
      <div class="grid">
        {pieces.map((p) => (
          <a class="card" href={`/weather/${p.run_id}/${p.slug}/`}>
            <Thumb
              base={`${PROD}/weather/${p.run_id}/${p.slug}`}
              alt=""
              viewTransitionName={`art-${p.run_id.replace(/-/g, "")}-${p.slug.replace(/-/g, "")}`}
            />
            <div class="card-body">
              <h3>{pieceH1(p.slug)}</h3>
              <p class="env">
                {formatCoords(p.lat, p.lng) && <span>{formatCoords(p.lat, p.lng)}</span>}
                {p.temp != null && <span>{p.temp.toFixed(1)}°C</span>}
                {p.wind_speed != null && <span>{p.wind_speed.toFixed(1)} m/s</span>}
                {p.pressure != null && <span>{p.pressure.toFixed(0)} hPa</span>}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}

    {page.lastPage > 1 && (
      <nav class="pager" aria-label="Gallery pages">
        {page.url.first && page.url.first !== page.url.current && (
          <a href={page.url.first}>First</a>
        )}
        {page.url.prev && <a href={page.url.prev} rel="prev">Previous</a>}
        <span class="muted">page {page.currentPage} / {page.lastPage}</span>
        {page.url.next && <a href={page.url.next} rel="next">Next</a>}
        {page.url.last && page.url.last !== page.url.current && (
          <a href={page.url.last}>Last</a>
        )}
      </nav>
    )}
  </section>
</Base>

<style>
  .artist-head { margin-bottom: 2rem; }
  h1 { font-size: 2.25rem; margin: 0 0 0.25rem; letter-spacing: -0.02em; }
  .lora-tag { color: var(--color-accent); }

  .methodology {
    margin: 0 0 3rem;
  }

  .gallery-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid #222;
    padding-bottom: 0.4rem;
    margin: 1rem 0;
  }
  h2 {
    font-size: 0.85rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  h3 {
    font-size: 0.9rem;
    margin: 0 0 0.25rem;
    color: var(--color-fg);
    text-transform: capitalize;
  }
  .empty { color: var(--color-muted); padding: 2rem 0; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    color: inherit;
    transition: transform 0.15s, border-color 0.15s;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-2px);
      border-color: #333;
      text-decoration: none;
    }
  }
  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-body { padding: 0.6rem 0.75rem 0.75rem; }
  .env {
    color: var(--color-muted);
    font-size: 0.72rem;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }

  .pager {
    margin: 3rem 0 1rem;
    padding: 1rem 0;
    border-top: 1px solid #222;
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .pager a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-link);
    text-decoration: none;
  }
  .pager a:hover { border-color: #444; background: #1a1a2e; }
</style>
